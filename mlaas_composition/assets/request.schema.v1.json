{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlaas.example/schema/composition-request.v1.json",
  "title": "Controlled synthetic collaborative composition request",
  "type": "object",
  "required": ["request_id", "request_schema_version", "composition_type", "functional_requirements", "qos_requirements", "hard_constraints", "composition_size", "preference_weights", "constraint_penalties"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "request_schema_version": {"const": "1.0.0"},
    "composition_type": {"const": "collaborative"},
    "functional_requirements": {"type": ["object", "string"]},
    "qos_requirements": {"type": ["object", "string"]},
    "hard_constraints": {"type": ["object", "string"]},
    "composition_size": {"type": "integer", "minimum": 1},
    "preference_weights": {"type": ["object", "string"]},
    "evaluation_requirements": {"type": ["object", "string"], "description": "Requested trust/explainability dimensions require complete benchmark_evaluation_v1 evidence by default; protocol_version can explicitly select production_evaluation_v1; allow_legacy explicitly enables historical experiments."},
    "constraint_penalties": {"type": ["object", "string"]},
    "request_profile_id": {"type": "string"},
    "principle_id": {"type": "string"},
    "generation_seed": {"type": "integer"}
  },
  "additionalProperties": true
}
